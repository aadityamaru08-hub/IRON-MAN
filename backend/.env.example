# Claude Anthropic API Key (required for live Claude agent runs, mock fallback provided if empty)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Configuration (optional; defaults to local in-memory mock DB if not set)
SUPABASE_URL=
SUPABASE_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
USE_MOCK_DB=true
